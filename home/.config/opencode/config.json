{
    "$schema": "https://opencode.ai/config.json",
    "theme": "gruvbox-material-dark",
    "model": "github-copilot/gpt-5",
    "keybinds": {
        "leader": "ctrl+x",
        "messages_half_page_up": "ctrl+u",
        "messages_half_page_down": "ctrl+d"
    },
    "provider": {
        "openrouter": {
            "npm": "@openrouter/ai-sdk-provider",
            "models": {
                "anthropic/claude-sonnet-4": {}
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {}
        },
        "zen": {
            "npm": "@opencode-ai/sdk",
            "models": {
                "zen:glm-4.7": {}
            }
        }
    },
    "agent": {
        "playwright-ui": {
            "description": "Browser-required UI/frontend tasks: checks, page navigation, element cloning, dev server/console inspections",
            "model": "zen:glm-4.7",
            "tools": {
                "playwright": true
            }
        }
    },
    "rules": {
        "routing": [
            {
                "match": ["playwright", "browser", "ui check", "frontend check", "page navigation", "element cloning", "dev server", "console logs"],
                "agent": "playwright-ui"
            }
        ]
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest",
                "--executable-path",
                "/snap/bin/chromium",
                "--isolated"
            ],
            "enabled": true
        }
    }
}
