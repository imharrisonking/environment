{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "**/dist/**",
    "build",
    "**/build/**",
    ".git",
    "**/.git/**",
    "coverage",
    "**/coverage/**",
    ".next",
    "**/.next/**",
    ".turbo",
    "**/.turbo/**",
    "*.tsbuildinfo",
    "**/*.tsbuildinfo",
    "home/.config/nvm/**",
    "packages/**"
  ]
}